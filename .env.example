# Copy this file to .env and edit it.
# Create the database in pgAdmin first (see README.md), then put its details here.

PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PGADMIN_PASSWORD@localhost:5432/cashnstore

# Any long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Set to production when you deploy behind HTTPS
NODE_ENV=development
