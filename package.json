{
  "name": "cashnstore",
  "version": "0.1.0",
  "description": "CashNStore: point of sale, inventory and GCash tracking for a small tindahan.",
  "main": "server/index.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "db:init": "node scripts/db.js init",
    "db:reset": "node scripts/db.js reset",
    "db:setup": "node scripts/db.js setup",
    "db:seed": "node scripts/db.js seed",
